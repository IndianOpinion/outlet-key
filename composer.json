{
    "name": "indianopinion/outlet-key",
    "description": "Resolve a news URL to the newsroom that owns it and to a stable article key. Ships a reviewed map of Indian outlets.",
    "type": "library",
    "license": "MIT",
    "keywords": ["url", "news", "publisher", "deduplication", "canonical", "amp", "outlet"],
    "homepage": "https://github.com/IndianOpinion/outlet-key",
    "support": {
        "issues": "https://github.com/IndianOpinion/outlet-key/issues",
        "source": "https://github.com/IndianOpinion/outlet-key",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\OutletKey\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\OutletKey\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/outlet-key"],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "validate-map": "@php bin/outlet-key validate",
        "check": ["@cs", "@analyse", "@validate-map", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
