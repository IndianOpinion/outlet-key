  "notes": {
    "bbc.co.uk": {
      "added": "2026-11-12",
      "text": "One newsroom on two registrable domains; the UK domain is keyed as bbc.com. Seed entry from the 0.1.0 product requirements."
    },
    "deccanherald.com": {
      "added": "2026-11-12",
      "examples": [
        "/india/some-headline-words-1234567"
      ],
      "text": "Article paths end in a numeric id after the slug. Seed entry from the 0.1.0 product requirements."
    },
    "economictimes.com": {
      "added": "2026-11-12",
      "text": "The short domain and its mobile host belong to the Economic Times newsroom under the indiatimes.com portal. Seed entry from the 0.1.0 product requirements."
    },
    "economictimes.indiatimes.com": {
      "added": "2026-11-12",
      "text": "Vertical hosts republish one article under new ids with the same headline slug, so the slug decides. Seed entry from the 0.1.0 product requirements."
    },
    "nasa.gov": {
      "added": "2026-11-12",
      "text": "Files one release under more than one path with the same headline slug. Seed entry from the 0.1.0 product requirements."
    },
    "ndtv.com": {
      "added": "2026-11-12",
      "examples": [
        "/india-news/some-headline-words-1234567",
        "/world-news/another-headline-7654321"
      ],
      "text": "Article paths end in a numeric id after the slug. Seed entry from the 0.1.0 product requirements."
    },
    "ndtv.in": {
      "added": "2026-11-12",
      "text": "The .in domain belongs to the NDTV newsroom. Seed entry from the 0.1.0 product requirements."
    },
    "news.google.com": {
      "added": "2026-11-12",
      "text": "A redirect wrapper: kept whole so it never merges with its parent company's own outlet, and listed as an aggregator. Seed entry from the 0.1.0 product requirements."
    },
    "thehindu.com": {
      "added": "2026-11-12",
      "examples": [
        "/news/national/some-headline/article12345678.ece"
      ],
      "text": "Article paths end in /article<id>.ece. Seed entry from the 0.1.0 product requirements."
    },
    "thehindubusinessline.com": {
      "added": "2026-11-12",
      "examples": [
        "/economy/some-headline/article12345678.ece"
      ],
      "text": "Article paths end in /article<id>.ece. Seed entry from the 0.1.0 product requirements."
    },
    "timesnownews.com": {
      "added": "2026-11-12",
      "examples": [
        "/india/some-headline-words-article-123456789"
      ],
      "text": "Article paths end in -article-<id>. Seed entry from the 0.1.0 product requirements."
    },
    "timesofindia.indiatimes.com": {
      "added": "2026-11-12",
      "examples": [
        "/city/delhi/other-headline/articleshow/123456789.cms",
        "/india/some-headline/articleshow/123456789.cms"
      ],
      "text": "Article paths carry /articleshow/<id>.cms. Seed entry from the 0.1.0 product requirements."
    }
  },
