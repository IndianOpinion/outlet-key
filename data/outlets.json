  },
  "articleIdRules": {
    "deccanherald.com": "~-([0-9]{6,})$~D",
    "ndtv.com": "~-([0-9]{6,})$~D",
    "thehindu.com": "~/article([0-9]{6,})\\.ece$~Di",
    "thehindubusinessline.com": "~/article([0-9]{6,})\\.ece$~Di",
    "timesnownews.com": "~-article-([0-9]{6,})$~Di",
    "timesofindia.indiatimes.com": "~/articleshow/([0-9]{6,})(?:\\.cms)?$~Di"
  },
  "caseInsensitivePaths": [],
